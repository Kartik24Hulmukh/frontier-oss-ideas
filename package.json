{
  "name": "simultaneity-index",
  "version": "1.6.2",
  "private": true,
  "description": "Simultaneity Index: live crowding + demand radar for builders, funds and AI agents (MCP)",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'tests/*.test.ts' && node --test tests/*.test.mjs",
    "smoke": "tsx scripts/smoke-score.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "calibrate": "tsx scripts/calibrate.ts",
    "mcp:stdio": "node bin/simultaneity-mcp.mjs",
    "gate": "node scripts/release-gate.mjs",
    "sublanes:live": "tsx scripts/sublane-live.ts",
    "llm:torture": "tsx scripts/llm-torture.ts",
    "redis:loopback": "tsx scripts/upstash-rest-emulator.ts",
    "keys:check": "node scripts/receipt-keygen.mjs --check docs/evidence/receipt-public-key.pem",
    "llm:hedge-live": "tsx scripts/adaptive-hedge-live.ts",
    "llm:hedge-sustained": "tsx scripts/adaptive-hedge-sustained.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.0",
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "bin": {
    "simultaneity-mcp": "bin/simultaneity-mcp.mjs"
  }
}
