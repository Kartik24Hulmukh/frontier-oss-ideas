{
  "name": "simultaneity-index",
  "version": "1.1.0",
  "private": true,
  "description": "Simultaneity Index: live crowding + demand radar for builders, funds and AI agents (MCP)",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "smoke": "tsx scripts/smoke-score.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.0",
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.2.0",
    "tsx": "4.19.0",
    "typescript": "5.7.3"
  },
  "bin": {
    "simultaneity-mcp": "scripts/mcp-server.mjs"
  },
  "files": [
    "app",
    "components",
    "lib",
    "scripts",
    "public"
  ]
}
