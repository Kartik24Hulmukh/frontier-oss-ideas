# Public canonical URL used for metadata, sitemap, and social previews.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Strongly recommended: authenticated GitHub API requests have higher rate limits.
GITHUB_TOKEN=

# OpenAlex requires a free API key in 2026.
OPENALEX_API_KEY=

# Polite identification sent to OpenAlex.
OPENALEX_MAILTO=you@example.com

# Demand side: Reddit blocks anonymous server traffic. Create a free "script" app at
# https://www.reddit.com/prefs/apps and paste its credentials (app-only OAuth).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Signed Ed25519 scan receipts (PKCS8 PEM; \n-escaped is fine). Generate with:
# node -e "const {generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
RECEIPT_PRIVATE_KEY=

# Abuse + quota protection
SCAN_RATE_LIMIT=20
SCAN_RATE_WINDOW_MS=600000
SCAN_CACHE_TTL_MS=1200000

# B2B cohort screening: comma-separated keys that bypass the public limit
COHORT_API_KEYS=
COHORT_MAX_IDEAS=25

# Optional: override Pulse leaderboard lanes (pipe-separated)
PULSE_LANES=

# Shared atomic admission for serverless / multi-instance deployments.
# Set REQUIRE_DISTRIBUTED_LIMITS=true for public production; fails closed without Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REQUIRE_DISTRIBUTED_LIMITS=false
# Optional independently pinned Ed25519 public key for receipt verification.
RECEIPT_PUBLIC_KEY=
# Optional JSON array of current + retired public PEMs for zero-downtime key rotation.
RECEIPT_PUBLIC_KEYS=

# AI analyst memo (/api/analyst) via the Melious gateway. Routed across GLM-5.3, GLM-5.3 Flash,
# Kimi K3 and Qwen 3.8 27B with per-model circuit breakers and token-budget ceilings.
# Leave empty to disable the endpoint (returns 503; deterministic brief still works).
MELIOUS_API_KEY=
MELIOUS_BASE_URL=https://api.melious.ai/v1
LLM_MAX_TOKENS_PER_REQUEST=6000
LLM_TOKEN_BUDGET_PER_WINDOW=400000
LLM_TOKEN_BUDGET_WINDOW_MS=3600000
ANALYST_RATE_LIMIT=6

# Provider pacing (1.3.1). Per-provider per-minute ceilings (default 25).
# GitHub Search hard caps: 30 authenticated / 10 anonymous searches per minute.
# PACING_GITHUB_PER_MINUTE=25
# PACING_REDDIT_PER_MINUTE=25

# LLM shared budget uses the same Upstash credentials. REQUIRE_DISTRIBUTED_LIMITS
# also fails LLM dispatch closed. Reserve worst-case chain tokens, no refunds.
# Rolling shared window includes the router deadline. Use one consistent config
# across replicas; provider-side spend limits remain mandatory.

# Reddit demand mirror fallback (used only when primary Reddit fails; results are labelled and weighted 50%)
# REDDIT_MIRROR_URL=https://api.pullpush.io/reddit/search/submission/
# REDDIT_MIRROR_DISABLED=false

# Stall hedging. adaptive = learn each model p90 and hedge at p90*multiplier (recommended).
LLM_HEDGE_MODE=adaptive
# Optional static fallback used only while a model has too few samples.
LLM_HEDGE_AFTER_MS=2500
# Adaptive knobs (defaults: 1.3 and 0.2).
LLM_HEDGE_P90_MULTIPLIER=1.3
LLM_HEDGE_MAX_RATE=0.2
